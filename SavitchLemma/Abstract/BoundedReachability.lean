module

public import Mathlib.Logic.Relation
public import Mathlib.Combinatorics.Quiver.Path.Vertices
public import Mathlib.Data.List.Nodup
public import SavitchLemma.Abstract.SavitchAlgorithm

import Mathlib.Data.Fintype.Card
import Mathlib.Data.Nat.Find
import Mathlib.Tactic.Positivity

@[expose] public section

/-!
# Bounded reachability in the abstract transition graph

`AbstractPath P n a b` records a path of exactly `n` edges.  `ReachesWithin`
then gives the at-most bound used in Savitch's midpoint argument.
-/

namespace SavitchLemma

variable {N : ℕ}

/-- An exactly-`n`-edge path in the abstract transition graph. -/
inductive AbstractPath (P : AbstractProblem N) :
    ℕ → Fin (N + 1) → Fin (N + 1) → Prop where
  | nil (a : Fin (N + 1)) : AbstractPath P 0 a a
  | cons {n : ℕ} {a b c : Fin (N + 1)}
      (edge : P.step a b) (tail : AbstractPath P n b c) :
      AbstractPath P (n + 1) a c

/-- Concatenating paths adds their exact lengths. -/
theorem AbstractPath.append (P : AbstractProblem N) {m n : ℕ}
    {a b c : Fin (N + 1)} (p : AbstractPath P m a b) (q : AbstractPath P n b c) :
    AbstractPath P (m + n) a c := by
  induction p with
  | nil => simpa using q
  | @cons m a mid b edge p ih =>
    simpa [Nat.add_assoc, Nat.add_comm 1 n] using AbstractPath.cons edge (ih q)

/-- The transition relation regarded as the arrows of a quiver. -/
@[instance_reducible]
def abstractQuiver (P : AbstractProblem N) : Quiver (Fin (N + 1)) :=
  ⟨fun a b => PLift (P.step a b)⟩

/-- Paths in the quiver generated by an abstract transition relation. -/
abbrev GraphPath (P : AbstractProblem N) (a b : Fin (N + 1)) :=
  @Quiver.Path (Fin (N + 1)) (abstractQuiver P) a b

/-- The length of a graph path. -/
def GraphPath.length (P : AbstractProblem N) {a b : Fin (N + 1)}
    (p : GraphPath P a b) : ℕ :=
  @Quiver.Path.length (Fin (N + 1)) (abstractQuiver P) a b p

/-- The vertex list of a graph path, including both endpoints. -/
def GraphPath.vertices (P : AbstractProblem N) {a b : Fin (N + 1)}
    (p : GraphPath P a b) : List (Fin (N + 1)) :=
  @Quiver.Path.vertices (Fin (N + 1)) (abstractQuiver P) a b p


/-- Every indexed path gives a quiver path of the same length. -/
theorem AbstractPath.exists_graphPath (P : AbstractProblem N) {length : ℕ}
    {a b : Fin (N + 1)} (p : AbstractPath P length a b) :
    ∃ q : GraphPath P a b, GraphPath.length P q = length := by
  let _ : Quiver (Fin (N + 1)) := abstractQuiver P
  induction p with
  | nil a => exact ⟨Quiver.Path.nil, rfl⟩
  | @cons n a mid b edge tail ih =>
    rcases ih with ⟨q, hq⟩
    refine ⟨(Quiver.Path.nil.cons (PLift.up edge)).comp q, ?_⟩
    have hq' : Quiver.Path.length q = n := by simpa [GraphPath.length] using hq
    simp [GraphPath.length, Quiver.Path.length_comp, hq']
    omega

/-- Every quiver path gives an indexed path of its exact length. -/
theorem GraphPath.exists_abstractPath (P : AbstractProblem N)
    {a b : Fin (N + 1)} (q : GraphPath P a b) :
    Nonempty (AbstractPath P (GraphPath.length P q) a b) := by
  let _ : Quiver (Fin (N + 1)) := abstractQuiver P
  induction q with
  | nil => exact ⟨AbstractPath.nil _⟩
  | cons pfx edge ih =>
    rcases ih with ⟨p⟩
    refine ⟨?_⟩
    simpa [GraphPath.length] using
      AbstractPath.append P p (AbstractPath.cons edge.down (AbstractPath.nil _))

/-- The vertices list has one more entry than the number of edges. -/
theorem GraphPath.vertices_length (P : AbstractProblem N)
    {a b : Fin (N + 1)} (q : GraphPath P a b) :
    (GraphPath.vertices P q).length = GraphPath.length P q + 1 := by
  let _ : Quiver (Fin (N + 1)) := abstractQuiver P
  exact Quiver.Path.vertices_length q

/-- A shortest graph path cannot visit the same vertex twice. -/
theorem GraphPath.vertices_nodup_of_minimal (P : AbstractProblem N)
    {a b : Fin (N + 1)} (p : GraphPath P a b)
    (hMin : ∀ q : GraphPath P a b, GraphPath.length P p ≤ GraphPath.length P q) :
    (GraphPath.vertices P p).Nodup := by
  let _ : Quiver (Fin (N + 1)) := abstractQuiver P
  change p.vertices.Nodup
  induction p with
  | nil => exact List.nodup_singleton _
  | cons pfx edge ih =>
    have hPrefixMin : ∀ q : Quiver.Path a pfx.end, pfx.length ≤ q.length := by
      intro q
      have h := hMin (q.cons edge)
      simpa [Quiver.Path.length_cons] using Nat.le_of_succ_le_succ h
    have hEndNotMem : (pfx.cons edge).end ∉ pfx.vertices := by
      intro hMem
      obtain ⟨p₁, p₂, hSplit⟩ :=
        pfx.exists_eq_comp_of_mem_vertices (v := (pfx.cons edge).end) hMem
      have hPrefixLength : pfx.length = p₁.length + p₂.length := by
        have h := congrArg Quiver.Path.length hSplit
        rw [Quiver.Path.length_comp] at h
        exact h
      have hShort : p₁.length < (pfx.cons edge).length := by
        rw [Quiver.Path.length_cons, hPrefixLength]
        omega
      exact Nat.not_lt_of_ge (hMin p₁) hShort
    change (pfx.vertices.concat (pfx.cons edge).end).Nodup
    rw [List.nodup_concat]
    exact ⟨hEndNotMem, ih hPrefixMin⟩

/-- At-most-`bound`-edge reachability. -/
def ReachesWithin (P : AbstractProblem N) (bound : ℕ)
    (a b : Fin (N + 1)) : Prop :=
  ∃ length, length ≤ bound ∧ AbstractPath P length a b

/-- Reachability within one step is exactly equality or one transition. -/
theorem ReachesWithin.one_iff (P : AbstractProblem N) {a b : Fin (N + 1)} :
    ReachesWithin P 1 a b ↔ a = b ∨ P.step a b := by
  constructor
  · rintro ⟨length, hLength, hPath⟩
    cases length with
    | zero =>
      cases hPath
      exact Or.inl rfl
    | succ length =>
      have hZero : length = 0 := by omega
      subst length
      cases hPath with
      | cons edge tail =>
        cases tail
        exact Or.inr edge
  · rintro (hEq | hEdge)
    · subst b
      exact ⟨0, Nat.zero_le _, AbstractPath.nil a⟩
    · exact ⟨1, le_rfl, AbstractPath.cons hEdge (AbstractPath.nil b)⟩

/-- Reflexive reachability uses zero edges. -/
theorem ReachesWithin.refl (P : AbstractProblem N) (bound : ℕ)
    (a : Fin (N + 1)) : ReachesWithin P bound a a :=
  ⟨0, Nat.zero_le _, AbstractPath.nil a⟩

/-- Every one-edge transition is reachable within one step. -/
theorem ReachesWithin.single (P : AbstractProblem N) {a b : Fin (N + 1)}
    (h : P.step a b) : ReachesWithin P 1 a b :=
  ⟨1, le_rfl, AbstractPath.cons h (AbstractPath.nil b)⟩

/-- Increasing the step bound preserves reachability. -/
theorem ReachesWithin.mono (P : AbstractProblem N) {m n : ℕ} {a b : Fin (N + 1)}
    (hBound : m ≤ n) (hReach : ReachesWithin P m a b) : ReachesWithin P n a b := by
  rcases hReach with ⟨length, hLength, hPath⟩
  exact ⟨length, le_trans hLength hBound, hPath⟩

/-- Concatenating two bounded paths adds their bounds. -/
theorem ReachesWithin.trans (P : AbstractProblem N) {m n : ℕ}
    {a b c : Fin (N + 1)} (h₁ : ReachesWithin P m a b)
    (h₂ : ReachesWithin P n b c) : ReachesWithin P (m + n) a c := by
  rcases h₁ with ⟨m', hm', p⟩
  rcases h₂ with ⟨n', hn', q⟩
  refine ⟨m' + n', ?_, AbstractPath.append P p q⟩
  exact Nat.add_le_add hm' hn'

/-- Split an exact path after its first `m` edges. -/
theorem AbstractPath.splitExact (P : AbstractProblem N) (m : ℕ) :
    ∀ {n : ℕ} {a b : Fin (N + 1)},
      AbstractPath P (m + n) a b →
      ∃ c, AbstractPath P m a c ∧ AbstractPath P n c b := by
  induction m with
  | zero =>
    intro n a b h
    exact ⟨a, AbstractPath.nil a, by simpa using h⟩
  | succ m ih =>
    intro n a b h
    rw [Nat.succ_add] at h
    cases h with
    | cons edge tail =>
      obtain ⟨c, hPrefix, hSuffix⟩ := ih tail
      exact ⟨c, AbstractPath.cons edge hPrefix, hSuffix⟩

/-- A nonempty path cannot end at the reserved zero code. -/
theorem AbstractPath.end_ne_zero (P : AbstractProblem N) {length : ℕ}
    {a b : Fin (N + 1)} (p : AbstractPath P length a b) (hLength : 0 < length) :
    b ≠ ⟨0, Nat.zero_lt_succ N⟩ := by
  induction p with
  | nil => omega
  | @cons n a mid b edge tail ih =>
    by_cases hn : n = 0
    · subst n
      cases tail with
      | nil =>
        intro hZero
        exact P.noStepToZero a (by simpa [hZero] using edge)
    · exact ih (Nat.pos_of_ne_zero hn)

/-- An at-most path of length `m + n` splits into an at-most-`m` prefix and
an at-most-`n` suffix. -/
theorem ReachesWithin.splitAdd (P : AbstractProblem N) (m n : ℕ)
    {a b : Fin (N + 1)} (hReach : ReachesWithin P (m + n) a b) :
    ∃ c, ReachesWithin P m a c ∧ ReachesWithin P n c b := by
  rcases hReach with ⟨length, hLength, hPath⟩
  by_cases hShort : length ≤ m
  · exact ⟨b, ⟨length, hShort, hPath⟩, ReachesWithin.refl P n b⟩
  · have hm : m ≤ length := Nat.le_of_not_ge hShort
    let suffixLength := length - m
    have hDecomp : length = m + suffixLength := by
      dsimp [suffixLength]
      omega
    have hSuffix : suffixLength ≤ n := by omega
    rw [hDecomp] at hPath
    obtain ⟨c, hPrefix, hSuffixPath⟩ := AbstractPath.splitExact P m hPath
    exact ⟨c, ⟨m, le_rfl, hPrefix⟩, ⟨suffixLength, hSuffix, hSuffixPath⟩⟩

/-- Split an at-most path while ensuring a positive midpoint when the endpoint
is positive and the prefix budget is nonzero. -/
theorem ReachesWithin.splitAdd_with_positive_midpoint (P : AbstractProblem N)
    (m n : ℕ) (hm : 0 < m) {a b : Fin (N + 1)} (hb : 0 < b.val)
    (hReach : ReachesWithin P (m + n) a b) :
    ∃ c, ReachesWithin P m a c ∧ ReachesWithin P n c b ∧ 0 < c.val := by
  rcases hReach with ⟨length, hLength, hPath⟩
  by_cases hShort : length ≤ m
  · exact ⟨b, ⟨length, hShort, hPath⟩, ReachesWithin.refl P n b, hb⟩
  · have hmLength : m ≤ length := Nat.le_of_not_ge hShort
    let suffixLength := length - m
    have hDecomp : length = m + suffixLength := by
      dsimp [suffixLength]
      omega
    have hSuffix : suffixLength ≤ n := by omega
    rw [hDecomp] at hPath
    obtain ⟨c, hPrefix, hSuffixPath⟩ := AbstractPath.splitExact P m hPath
    have hCNeZero := AbstractPath.end_ne_zero P hPrefix hm
    have hCPos : 0 < c.val := by
      by_contra hNotPos
      have hVal : c.val = 0 := by omega
      have hEq : c = ⟨0, Nat.zero_lt_succ N⟩ := Fin.ext hVal
      exact hCNeZero hEq
    exact ⟨c, ⟨m, le_rfl, hPrefix⟩, ⟨suffixLength, hSuffix, hSuffixPath⟩, hCPos⟩

/-- Exact bounded paths imply ordinary reflexive-transitive reachability. -/
theorem AbstractPath.toReflTransGen (P : AbstractProblem N)
    {length : ℕ} {a b : Fin (N + 1)} (h : AbstractPath P length a b) :
    Relation.ReflTransGen P.step a b := by
  induction h with
  | nil => exact Relation.ReflTransGen.refl
  | cons edge _ ih => exact (Relation.ReflTransGen.single edge).trans ih

/-- Reflexive-transitive reachability has a finite exact-length path witness. -/
theorem reflTransGen_iff_exists_path (P : AbstractProblem N)
    {a b : Fin (N + 1)} :
    Relation.ReflTransGen P.step a b ↔ ∃ length, AbstractPath P length a b := by
  constructor
  · intro h
    induction h with
    | refl => exact ⟨0, AbstractPath.nil _⟩
    | @tail mid dest hPath hEdge ih =>
      rcases ih with ⟨length, p⟩
      exact ⟨length + 1,
        AbstractPath.append P p (AbstractPath.cons hEdge (AbstractPath.nil dest))⟩
  · rintro ⟨_, h⟩
    exact AbstractPath.toReflTransGen P h

/-- In a graph with `N + 1` vertices, every reachable pair has a path of at
most `N` edges.  A shortest path has no repeated vertices. -/
theorem reachesWithin_of_reflTransGen (P : AbstractProblem N)
    {a b : Fin (N + 1)} (hReach : Relation.ReflTransGen P.step a b) :
    ReachesWithin P N a b := by
  classical
  rcases (reflTransGen_iff_exists_path P).mp hReach with ⟨length, p⟩
  obtain ⟨q, _hqLength⟩ := AbstractPath.exists_graphPath P p
  let hasPath : ℕ → Prop := fun n => ∃ q : GraphPath P a b, GraphPath.length P q = n
  have hExists : ∃ n, hasPath n := ⟨GraphPath.length P q, q, rfl⟩
  let minLength := Nat.find hExists
  obtain ⟨shortest, hShortestLength⟩ := Nat.find_spec hExists
  have hMinimal : ∀ q : GraphPath P a b,
      GraphPath.length P shortest ≤ GraphPath.length P q := by
    intro q
    rw [hShortestLength]
    exact Nat.find_min' hExists ⟨q, rfl⟩
  have hVerticesNodup := GraphPath.vertices_nodup_of_minimal P shortest hMinimal
  have hVerticesCard := List.Nodup.length_le_card hVerticesNodup
  have hVertexCount := GraphPath.vertices_length P shortest
  have hLengthBound : GraphPath.length P shortest + 1 ≤ N + 1 := by
    calc
      GraphPath.length P shortest + 1 = (GraphPath.vertices P shortest).length :=
        hVertexCount.symm
      _ ≤ Fintype.card (Fin (N + 1)) := hVerticesCard
      _ = N + 1 := by simp
  have hBound : minLength ≤ N := by
    rw [hShortestLength] at hLengthBound
    omega
  obtain ⟨shortPath⟩ := GraphPath.exists_abstractPath P shortest
  have hPath : AbstractPath P minLength a b := by
    change AbstractPath P (Nat.find hExists) a b
    rw [← hShortestLength]
    exact shortPath
  exact ⟨minLength, hBound, hPath⟩

/-- A path of at most `2^(k+1)` edges splits into two paths of at most `2^k` edges. -/
theorem ReachesWithin.splitPowTwo (P : AbstractProblem N) (k : ℕ)
    {a b : Fin (N + 1)} (hReach : ReachesWithin P (2 ^ (k + 1)) a b) :
    ∃ midpoint, ReachesWithin P (2 ^ k) a midpoint ∧
      ReachesWithin P (2 ^ k) midpoint b := by
  have hPow : 2 ^ (k + 1) = 2 ^ k + 2 ^ k := by
    simp [pow_succ, Nat.mul_two]
  rw [hPow] at hReach
  exact ReachesWithin.splitAdd P (2 ^ k) (2 ^ k) hReach

/-- The power-of-two split can choose a positive midpoint when its endpoint
is positive. -/
theorem ReachesWithin.splitPowTwo_with_positive_midpoint (P : AbstractProblem N)
    (k : ℕ) {a b : Fin (N + 1)} (hb : 0 < b.val)
    (hReach : ReachesWithin P (2 ^ (k + 1)) a b) :
    ∃ midpoint, ReachesWithin P (2 ^ k) a midpoint ∧
      ReachesWithin P (2 ^ k) midpoint b ∧ 0 < midpoint.val := by
  have hPow : 2 ^ (k + 1) = 2 ^ k + 2 ^ k := by
    simp [pow_succ, Nat.mul_two]
  rw [hPow] at hReach
  exact ReachesWithin.splitAdd_with_positive_midpoint P (2 ^ k) (2 ^ k)
    (by positivity) hb hReach

end SavitchLemma
